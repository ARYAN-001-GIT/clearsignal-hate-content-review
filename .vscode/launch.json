{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ClearSignal dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal"
    },
    {
      "name": "Train on HateXplain",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_model.py",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal"
    }
  ]
}
